{
  "name": "nexbit-pos",
  "version": "1.0.2",
  "description": "Nexbit POS - Punto de venta moderno para Windows",
  "main": "src/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron . --dev",
    "dev": "concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build": "vite build && node scripts/copy-wasm.js && electron-builder",
    "dist": "vite build && node scripts/copy-wasm.js && electron-builder --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "vite": "^5.4.21",
    "wait-on": "^8.0.5",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.nexbit.pos",
    "productName": "Nexbit POS",
    "publish": [
      {
        "provider": "github",
        "owner": "josemolina127-web",
        "repo": "nexbit-pos"
      }
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**",
      "src/main/**",
      "src/database/**",
      "package.json"
    ],
    "asarUnpack": [
      "dist/renderer/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Nexbit-POS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Nexbit-POS-Portable-${version}.${ext}"
    }
  },
  "keywords": [
    "pos",
    "punto-de-venta",
    "electron"
  ],
  "author": "Nexbit",
  "license": "ISC"
}
